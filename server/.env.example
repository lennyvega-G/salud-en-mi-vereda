# Copie este archivo como .env y ajuste los valores

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salud_vereda
# true si la base de datos está en la nube (Render, Neon)
DATABASE_SSL=false

# Texto largo y secreto para firmar las sesiones
JWT_SECRET=cambie-este-texto-por-uno-largo-y-secreto

# 64 caracteres hexadecimales. Genere uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=pegue-aqui-los-64-caracteres-generados-con-el-comando-de-arriba

PORT=3000
